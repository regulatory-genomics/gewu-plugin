[
  {"name":"init","description":"Create a Paper manuscript directory using the native template.","effect":"write","target":"backend","exposeToAgent":true,
    "inputSchema":{"type":"object","required":["directory"],"properties":{"directory":{"type":"string","minLength":1}},"additionalProperties":false},
    "outputSchema":{"type":"object","required":["project"],"properties":{"project":{"type":"object"}}}},
  {"name":"describe","description":"Describe ordered Paper source files and get the project revision without compiling.","effect":"read","target":"backend","exposeToAgent":true,
    "inputSchema":{"type":"object","required":["project"],"properties":{"project":{"type":"object","required":["uri","type"],"properties":{"uri":{"type":"string"},"type":{"const":"paper.project"},"revision":{"type":"string"}},"additionalProperties":false}},"additionalProperties":false},
    "outputSchema":{"type":"object","required":["project","sources","supplement","outputStem"],"properties":{"project":{"type":"object"},"sources":{"type":"array"},"supplement":{"type":"array"},"outputStem":{"type":"string"},"metadata":{"type":"object"}}}},
  {"name":"document","description":"Read the editable manuscript: every source block with its file, byte range, revision and whether it can be edited in place.","effect":"read","target":"backend","exposeToAgent":true,
    "inputSchema":{"type":"object","required":["project"],"properties":{"project":{"type":"object","required":["uri","type"],"properties":{"uri":{"type":"string"},"type":{"const":"paper.project"},"revision":{"type":"string"}},"additionalProperties":false}},"additionalProperties":false},
    "outputSchema":{"type":"object","required":["project","files"],"properties":{"project":{"type":"object"},"files":{"type":"array"},"canUndo":{"type":"boolean"},"canRedo":{"type":"boolean"}}}},
  {"name":"edit","description":"Replace one manuscript block. The file revision and block range must still be current; Paper validates the result before anything is written.","effect":"write","target":"backend","exposeToAgent":true,
    "inputSchema":{"type":"object","required":["project","file","byteStart","byteEnd","text","fileRevision"],
      "properties":{"project":{"type":"object","required":["uri","type"],"properties":{"uri":{"type":"string"},"type":{"const":"paper.project"},"revision":{"type":"string"}},"additionalProperties":false},
        "file":{"type":"string","minLength":1},"byteStart":{"type":"integer","minimum":0},"byteEnd":{"type":"integer","minimum":0},
        "text":{"type":"string"},"fileRevision":{"type":"string","minLength":1}},"additionalProperties":false},
    "outputSchema":{"type":"object","required":["project","files"],"properties":{"project":{"type":"object"},"files":{"type":"array"},"edit":{"type":"object"}}}},
  {"name":"undo","description":"Undo the last manuscript edit if the project still matches the expected revision.","effect":"write","target":"backend","exposeToAgent":true,
    "inputSchema":{"type":"object","required":["project"],"properties":{"project":{"type":"object","required":["uri","type"],"properties":{"uri":{"type":"string"},"type":{"const":"paper.project"},"revision":{"type":"string"}},"additionalProperties":false},"expectedRevision":{"type":"string"}},"additionalProperties":false},
    "outputSchema":{"type":"object","required":["project","files"],"properties":{"project":{"type":"object"},"files":{"type":"array"},"canUndo":{"type":"boolean"},"canRedo":{"type":"boolean"}}}},
  {"name":"redo","description":"Redo the edit that undo reverted, if the project still matches the expected revision.","effect":"write","target":"backend","exposeToAgent":true,
    "inputSchema":{"type":"object","required":["project"],"properties":{"project":{"type":"object","required":["uri","type"],"properties":{"uri":{"type":"string"},"type":{"const":"paper.project"},"revision":{"type":"string"}},"additionalProperties":false},"expectedRevision":{"type":"string"}},"additionalProperties":false},
    "outputSchema":{"type":"object","required":["project","files"],"properties":{"project":{"type":"object"},"files":{"type":"array"},"canUndo":{"type":"boolean"},"canRedo":{"type":"boolean"}}}},
  {"name":"build","description":"Compile a pinned Paper project revision into the requested formats; TeX is always included.","effect":"write","target":"backend","exposeToAgent":true,
    "inputSchema":{"type":"object","required":["project","formats"],"properties":{"project":{"type":"object","required":["uri","type","revision"],"properties":{"uri":{"type":"string"},"type":{"const":"paper.project"},"revision":{"type":"string"}},"additionalProperties":false},"formats":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["pdf","html","docx"]}}},"additionalProperties":false},
    "outputSchema":{"type":"object","required":["formats","sourceRevision"],"properties":{"formats":{"type":"array","items":{"enum":["pdf","html","docx","tex"]}},"sourceRevision":{"type":"string"}}}}
]
