#!/bin/sh
# Verify NSS and browser operations offline. GeWu runs this in the staged
# generation before activating the plugin.
set -eu
"$GEWU_RUNTIME_ROOT/bin/python" - <<'PY'
import os
import sys
import ctypes
from pathlib import Path
import playwright
from playwright.sync_api import sync_playwright

# NSS loads these at runtime; a data: page alone misses incompatible host modules.
libraries = Path(os.environ["GEWU_RUNTIME_ROOT"]) / "chromium-libs"
for module in ("libsoftokn3.so", "libfreeblpriv3.so", "libfreebl3.so", "libnssdbm3.so"):
    path = libraries / module
    if not path.is_file():
        raise SystemExit(f"packed NSS module is missing: {path}")
    ctypes.CDLL(str(path))
nss = ctypes.CDLL(str(libraries / "libnss3.so"))
nss.NSS_NoDB_Init.argtypes = [ctypes.c_char_p]
nss.PK11_GetInternalKeySlot.restype = ctypes.c_void_p
nss.PK11_FreeSlot.argtypes = [ctypes.c_void_p]
if nss.NSS_NoDB_Init(None) != 0:
    raise SystemExit("packed NSS initialization failed")
slot = nss.PK11_GetInternalKeySlot()
if not slot:
    raise SystemExit("packed NSS internal key slot is unavailable")
nss.PK11_FreeSlot(slot)
if nss.NSS_Shutdown() != 0:
    raise SystemExit("packed NSS shutdown failed")

with sync_playwright() as p:
    executable = p.chromium.executable_path
    if not executable or not os.path.exists(executable):
        raise SystemExit(f"chromium executable is missing: {executable}")
    browser = p.chromium.launch(headless=True, executable_path=executable,
                                chromium_sandbox=True, timeout=20_000)
    try:
        page = browser.new_page()
        page.goto("data:text/html,<input aria-label='test'><button>Apply</button>", timeout=5_000)
        page.get_by_label("test").fill("GeWu")
        page.get_by_role("button", name="Apply").click()
        if page.get_by_label("test").input_value() != "GeWu" or not page.screenshot().startswith(b"\x89PNG\r\n\x1a\n"):
            raise SystemExit("browser did not complete input and screenshot smoke")
    finally:
        browser.close()
print(f"ok python={sys.version.split()[0]} chromium={executable}")
PY
