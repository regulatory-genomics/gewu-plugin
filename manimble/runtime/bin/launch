#!/bin/sh
set -eu
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
if [ -f "$GEWU_RUNTIME_ROOT/certs/ca-bundle.crt" ]; then export SSL_CERT_FILE="$GEWU_RUNTIME_ROOT/certs/ca-bundle.crt"; fi
export PYTHONPATH="$GEWU_PLUGIN_ROOT/lib"
export PATH="$GEWU_RUNTIME_ROOT/env/bin:/usr/bin:/bin"
if [ -d "$GEWU_RUNTIME_ROOT/tex/bin" ]; then export PATH="$GEWU_RUNTIME_ROOT/tex/bin:$PATH"; fi
exec "$GEWU_RUNTIME_ROOT/env/bin/python" "$GEWU_PLUGIN_ROOT/adapter.py"
