{
  "schemaVersion": "gewu.runtime-plan/v1",
  "policies": ["external", "managed"],
  "providers": [
    {
      "kind": "external",
      "id": "manimble-python",
      "target": {"os": "linux", "arch": "x86_64", "libc": "glibc"},
      "executable": {
        "env": "MANIMBLE_PYTHON",
        "commands": ["python3.11", "python3"]
      },
      "probe": {
        "args": ["-c", "import manim, manim_slides, PIL, pptx"],
        "timeoutSeconds": 180
      },
      "binaries": {"python3": "{executable}", "python": "{executable}", "launch": "{executable}"}
    },
    {
      "kind": "managed",
      "id": "manimble-micromamba",
      "target": {"os": "linux", "arch": "x86_64", "libc": "glibc"},
      "manager": "micromamba",
      "channels": ["conda-forge"],
      "packages": ["python=3.11", "cairo", "pango", "pkg-config", "manimpango=0.7.1", "pycairo"],
      "pipExtraIndex": "https://pypi.org/simple",
      "pip": [
        "manim==0.21.0",
        "manim-slides==5.7.0",
        "Pillow==12.3.0",
        "matplotlib==3.11.2",
        "python-pptx==1.0.2",
        "biocartoon==0.4.3",
        "imageio-ffmpeg==0.6.0"
      ],
      "probe": {
        "args": ["-c", "import manim, manim_slides, PIL, pptx"],
        "timeoutSeconds": 900
      },
      "binaries": {"python3": "{executable}", "python": "{executable}", "launch": "{executable}"}
    }
  ]
}
